# 复制为 .env 并填入实际值

# ---------- 基础 ----------
PORT=8089
MONGODB_URI=mongodb://localhost:27017/personal-blog

# JWT — 必填,随机长字符串(建议 64+ 字节)
JWT_SECRET=change-me-to-a-long-random-string
# 普通(GitHub)用户 JWT 有效期,可选,默认 30d
JWT_EXPIRE=30d

# 部署环境(production 时启用 cookie secure 标志等)
NODE_ENV=development

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Callback URL 三选一(优先级从上到下):
#   1) 直接给完整 URL — 优先级最高
GITHUB_CALLBACK_URL=http://localhost:8089/api/auth/github/callback
#   2) 只给后端根域名,自动拼成 <BACKEND_URL>/api/auth/github/callback
# BACKEND_URL=https://api.your-domain.com
#   3) 都不填 → 回退到 http://localhost:${PORT}/api/auth/github/callback

# 前端地址 — 用于 OAuth 回跳重定向 + 评论/点赞 Origin 校验
# 同时被加入 CORS 白名单(任何非白名单 Origin 都会被拒绝,杜绝跨站读响应)
FRONTEND_URL=http://localhost:5173

# (可选) 额外 CORS 允许的 Origin,逗号分隔。比如双子域、备用域名、本地预览端口
# ALLOWED_ORIGINS=http://localhost:4173,https://blog-staging.example.com

# ---------- Cloudflare Turnstile (可选) ----------
# 未填或保留占位符时,Turnstile 验证会自动跳过
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ---------- 管理员凭据 ----------
# 邮箱格式会被直接当作 username + email 使用;非邮箱字符串则自动追加 @local.admin
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# 管理员会话有效期(天),默认 7。写入 HttpOnly cookie,刷新/重启浏览器仍保持登录。
ADMIN_TOKEN_TTL_DAYS=7

# ---------- AI 评论审核 (可选, OpenAI 兼容) ----------
# 支持任意 OpenAI 兼容的 /chat/completions 端点:OpenAI / DeepSeek / Moonshot / OpenRouter / 本地 Ollama...
# 这些值作为默认配置;也可以在后台「AI 审核」面板覆盖并存库(改配置无需重启)
#
# Base URL(填到版本路径,自动拼接 /chat/completions)
AI_BASE_URL=https://api.openai.com/v1
# API key,逗号分隔多个自动轮询;每个 (key, 模型) 各自限流(见 AI_RPM/AI_RPD)
AI_API_KEYS=
# 模型,逗号分隔多个自动负载均衡
AI_MODELS=gpt-4o-mini
# 限流:每 key 每模型 每分钟 / 每天 请求上限(超出进待审队列,等配额恢复自动重审)
AI_RPM=10
AI_RPD=1500
# 是否启用 AI 审核(true/false;未配 key 时即使为 true 也会自动放行评论)
AI_ENABLED=true
# (可选) 出站代理 — 国内服务器调海外 API 时常用;支持 socks5/socks5h/socks、http、https,可带 user:pass
# 优先级: AI_PROXY > GEMINI_PROXY(旧) > HTTPS_PROXY > HTTP_PROXY;示例:
#   AI_PROXY=socks5://127.0.0.1:1080
#   AI_PROXY=http://proxy.example.com:8080
# 注意:后台面板若显式清空代理(=留空保存),即以直连为准,覆盖本环境变量
AI_PROXY=
