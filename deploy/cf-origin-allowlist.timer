[Unit]
Description=定期重放 Cloudflare 回源白名单规则(网段每天刷新一次)
Documentation=https://developers.cloudflare.com/fundamentals/concepts/cloudflare-ip-addresses/

[Timer]
# 每 10 分钟重放一次。重放是幂等的、几乎不耗资源,作用是自愈:
# 万一同机上别的组件(mailcow 的 netfilter 容器、docker)动了 INPUT 链,
# 最多 10 分钟规则就回来了。网段本身仍然只每 24 小时拉一次。
#
# 这里**只放墙钟刻度,不放 OnBootSec**。开机那一次由 cf-origin-allowlist.service
# 自己挂在 multi-user.target 上完成 —— 单调触发点和墙钟刻度混在同一个 timer 里时,
# 实测 systemd 会因为那个早已过去的 OnBootSec 而算不出下一次触发
# (NextElapseUSecMonotonic=infinity,`list-timers` 的 NEXT 是空的,定时器静默失效)。
OnCalendar=*:0/10

# 错过的时间点(机器关机期间)不补跑 —— 开机那次由服务自己兜住。
Persistent=false

[Install]
WantedBy=timers.target
